# ── Vigilagent V6 Environment Configuration ──
# Copy this to .env and fill in your values

# === Required ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
# Direct Postgres connection for migrations (python -m backend.db_migrate).
# Get it from Supabase Dashboard → Project Settings → Database → Connection
# string → Pooler (Transaction). NOTE: the hostname is aws-N-<region>.
# pooler.supabase.com where N is NOT always 0 (this project: aws-1-ap-south-1).
# The legacy db.<ref>.supabase.co direct host is IPv6-only and will not work
# on machines without IPv6 connectivity — use the pooler instead.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
OPENROUTER_API_KEY=sk-or-...

# === Required: AI Models ===
# ── NVIDIA TACTICAL engine (PRIMARY — benchmark-verified fastest strict-JSON under 50B) ──
# Get a free nvapi- key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Reasoning effort (low/medium/high/xhigh) — used by Nemotron 3 / Muse family.
# NOT min/max_thinking_tokens — those 400 on these models.
NVIDIA_REASONING_EFFORT=medium
NVIDIA_MIN_THINKING_TOKENS=1024
NVIDIA_MAX_THINKING_TOKENS=2048
NVIDIA_MAX_OUTPUT_TOKENS=2048

# ── NVIDIA STRATEGIC engine (second key/model — planning, arbitration, reporting) ──
# Uses a SECOND nvapi- key (separate rate limit). Falls back to NVIDIA_API_KEY when unset.
NVIDIA_API_KEY_2=nvapi-your-second-nvidia-api-key
NVIDIA_MODEL_2=nvidia/llama-3.3-nemotron-super-49b-v1

# Gemini (fallback tactical LLM when NVIDIA is rate-limited/unavailable)
GEMINI_API_KEY=your-gemini-api-key

# === Required: API Auth ===
API_AUTH_KEY=your-secure-api-key-min-32-chars
TESTING=false

# === Required: Redis (no default password — must be set explicitly) ===
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379
# Pool sized for the full 13-agent swarm — parallel recon + attack load was
# exhausting the old 50-conn pool and 5s socket timeout (Chi audit-loop
# "Timeout reading from 127.0.0.1:6380" errors). Tune down for small setups.
REDIS_MAX_CONNECTIONS=150
REDIS_SOCKET_TIMEOUT=15
REDIS_CONNECT_TIMEOUT=10
REDIS_HEALTH_CHECK_INTERVAL=20

# === Required: Grafana (monitoring profile only) ===
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=your-grafana-admin-password

# === Optional: CORS (comma-separated) ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Optional: Monitoring Notifications ===
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=ops@vigilagent.dev

# === Alpha V6 Recon Engine ===
ALPHA_ENABLE_V6=true
ALPHA_TOOL_ROOT=D:\projects
ALPHA_ARTIFACT_ROOT=data/scans
ALPHA_DEFAULT_MODE=STANDARD
ALPHA_DEFAULT_RPS=50
ALPHA_MAX_HTTPX_THREADS=50
ALPHA_MAX_CRAWL_DEPTH=3
ALPHA_ENABLE_EXTERNAL_TOOLS=false
ALPHA_TOOL_TIMEOUT_SECONDS=180
# ALPHA_EXPLICIT_AUTHORIZATION removed - use scope.yaml authorization field instead

# === Optional: PinchTab Browser ===
ALPHA_ENABLE_PINCHTAB=true
PINCHTAB_BASE_URL=http://127.0.0.1:9867
PINCHTAB_HEADLESS=true

# === Optional: OpenClaw Browser ===
OPENCLAW_ENABLED=true
OPENCLAW_HEADLESS=true
OPENCLAW_BROWSER=chromium
OPENCLAW_TIMEOUT=30000
OPENCLAW_STEALTH=true
OPENCLAW_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
OPENCLAW_VIEWPORT_WIDTH=1920
OPENCLAW_VIEWPORT_HEIGHT=1080
OPENCLAW_MAX_CONTEXTS=5
OPENCLAW_CHROMIUM_PATH=/usr/bin/chromium-browser

# === Optional: Hybrid Browser Orchestration ===
HYBRID_BROWSER_ENABLED=true
HYBRID_DEFAULT_ENGINE=auto
HYBRID_AUTO_FALLBACK=true
HYBRID_SESSION_SHARING=true
HYBRID_FORENSICS_ENABLED=true
HYBRID_FORENSICS_DIR=scan_states/forensics
HYBRID_SESSION_DIR=scan_states/sessions

# === Optional: Neo4j Graph ===
ALPHA_ENABLE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# === Optional: OpenCTI STIX Export ===
ALPHA_ENABLE_OPENCTI_EXPORT=false
OPENCTI_URL=
OPENCTI_TOKEN=

# === Scan Settings ===
SCAN_TIMEOUT=600

# === Deep System Integration (config/integration.yaml is the source of truth) ===
# These env vars override the YAML for prod / 12-factor deploys. In dev, just
# leave them unset and let config/integration.yaml drive the rollout cohort.

# Task 3.8 — browser learning
ENABLE_BROWSER_LEARNING=true
BROWSER_LEARNING_ROLLOUT_PCT=10

# Task 5.11 — skill library v2
ENABLE_SKILL_LIBRARY_V2=true
SKILL_LIBRARY_ROLLOUT_PCT=25

# Task 7.8 — browser health monitoring
ENABLE_BROWSER_HEALTH_MONITORING=true
HEALTH_MONITORING_ROLLOUT_PCT=50

# Task 9.10 — self-healing engine
ENABLE_SELF_HEALING=true
SELF_HEALING_ROLLOUT_PCT=75

# Task 11.8 — unified knowledge graph
ENABLE_UNIFIED_GRAPH=true
UNIFIED_GRAPH_ROLLOUT_PCT=100

# Task 13.11 — intelligent routing + forensic learning
ENABLE_INTELLIGENT_ROUTING=true
ENABLE_FORENSIC_LEARNING=true
ROUTING_FORENSICS_ROLLOUT_PCT=100

# Resource caps (kept conservative even at 100% rollout)
EVENT_BATCH_SIZE=50
EVENT_BATCH_TIMEOUT_MS=200
MAX_CONCURRENT_LEARNING=8
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_S=60
